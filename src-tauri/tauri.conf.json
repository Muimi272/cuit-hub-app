{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUIT Hub",
  "version": "1.0.0",
  "identifier": "dev.cuit.hub",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "devUrl": "https://hub.cuit.dev",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CUIT Hub",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "https://hub.cuit.dev"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "shortDescription": "CUIT Hub",
    "longDescription": "CUIT Hub WebView application for desktop and Android.",
    "category": "SocialNetworking",
    "copyright": "CUIT Hub",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"]
  }
}
